<mujoco model="unicycle_robot">
  <compiler angle="degree" coordinate="local" inertiafromgeom="true"/>

  <option gravity="0 0 -9.81" timestep="0.002">
    <flag energy="enable"/>
  </option>

  <default>
    <joint armature="0.005" damping="0.01"/>
    <geom condim="3" friction="1.0 0.005 0.0001" solref="0.004 1"/>
  </default>

  <asset>
    <material name="wheel_mat" rgba="0.2 0.2 0.9 1"/>
    <material name="body_mat" rgba="0.8 0.2 0.2 1"/>
    <material name="caster_mat" rgba="0.2 0.8 0.2 1"/>
  </asset>

  <worldbody>
    <!-- CHASSIS / KORPUS ROBOTA -->
    <body name="chassis" pos="0 0 0.25">
      <freejoint name="root"/>
      
      <!-- Główny korpus robota -->
      <geom name="body_geom" type="box" size="0.2 0.15 0.04" material="body_mat" mass="2.0"/>

      <!-- KOŁO LEWE -->
      <body name="wheel1" pos="-0.2 0.18 -0.05">
        <joint name="drive_joint1" type="hinge" axis="0 1 0"/>
        <geom name="wheel_geom1" type="cylinder" size="0.12 0.025" zaxis="0 1 0" material="wheel_mat" mass="0.6"/>
      </body>

      <!-- KOŁO PRAWE -->
      <body name="wheel2" pos="-0.2 -0.18 -0.05">
        <joint name="drive_joint2" type="hinge" axis="0 1 0"/>
        <geom name="wheel_geom2" type="cylinder" size="0.12 0.025" zaxis="0 1 0" material="wheel_mat" mass="0.6"/>
      </body>

      <!-- CASTER -->
      <body name="caster" pos="0.15 0 -0.13">
        <joint name="caster_joint" type="ball" damping="0.05"/>
        <geom name="caster_geom" type="sphere" size="0.04" material="caster_mat" mass="0.05" friction="0.05"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="drive_motor1" joint="drive_joint1" ctrlrange="-10 10" gear="0.1"/>
    <motor name="drive_motor2" joint="drive_joint2" ctrlrange="-10 10" gear="0.1"/>
  </actuator>
</mujoco>